##############################################################################
# central/ — example variable values (copy to terraform.tfvars and fill in)
#
# Two layouts are supported. Pick ONE of the blocks below for child account
# discovery. COS provisioning is always handled by this workspace.
##############################################################################

# IBM Cloud region where the central COS archive bucket will be created
ibmcloud_region = "us-south"

##############################################################################
# COS archive bucket
#
# Layout A — let this workspace create both COS instance and bucket:
#   Leave cos_instance_crn and cos_bucket_name empty (the defaults).
#   The instance will be named cos_instance_name and the bucket will get a
#   random suffix.
#
# Layout B — reuse an existing COS instance, let this workspace create the bucket:
#   Set cos_instance_crn to the CRN of the existing instance.
#
# Layout C — reuse an existing COS instance AND an existing bucket:
#   Set both cos_instance_crn and cos_bucket_name.
##############################################################################

# Name for the COS instance when this workspace creates one (Layout A only).
# cos_instance_name = "central-logs-archive"

# CRN of an existing COS instance (Layout B and C).
#   ibmcloud resource service-instance <name> --output json | jq -r '.[0].crn'
# cos_instance_crn = "crn:v1:bluemix:public:cloud-object-storage:global:a/REPLACE_ACCOUNT_ID:REPLACE_INSTANCE_GUID::"

# Name of the central archive bucket (Layout C, or to override the generated name).
# cos_bucket_name = "my-central-logs-archive"

##############################################################################
# Layout A — this workspace runs in the enterprise (management) account.
# Nothing else is required: discovery is on by default and the management
# account plus the central account are excluded automatically.
##############################################################################

# Optional extra scoping, only if the identity can see more than one enterprise
# enterprise_name = "My Enterprise"

# Optional: accounts you deliberately keep out of centralized logging
# excluded_account_ids = ["SOME_SANDBOX_ACCOUNT_ID"]

##############################################################################
# Layout B — this workspace runs in a dedicated central account that has no
# enterprise access. Supply the child account list explicitly; run this from
# the enterprise account to produce it:
#
#   ibmcloud enterprise accounts --output JSON | jq -r '.[].id'
#
# Re-run that command and update this list whenever an account joins the
# enterprise, then re-apply.
##############################################################################

# child_account_ids = [
#   "REPLACE_CHILD_ACCOUNT_ID_1",
#   "REPLACE_CHILD_ACCOUNT_ID_2",
# ]

##############################################################################
# Rarely changed
##############################################################################

# Optional: set the account ID explicitly instead of deriving it from the COS CRN.
# central_account_id = "REPLACE_CENTRAL_ACCOUNT_ID"

# Storage class for the archive bucket. "smart" lowers cost for rarely read
# data while keeping it immediately queryable by IBM Cloud Logs.
# cos_bucket_storage_class = "standard"

# Delete log objects from the archive bucket after this many days.
# 0 (default) keeps logs forever — set this to your retention requirement.
# cos_expire_days = 365

# Transition objects to an archive tier after this many days (0 = disabled).
# WARNING: GLACIER/ACCELERATED objects must be restored before Cloud Logs can
# query them. Must be lower than cos_expire_days when both are set.
# cos_archive_days = 0
# cos_archive_type = "GLACIER"

# Account states to include. Set to [] if your enterprise returns a state
# value that is not "ACTIVE" — check the enterprise_accounts output.
# included_account_states = ["ACTIVE"]
