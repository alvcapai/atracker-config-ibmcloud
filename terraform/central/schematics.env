# IBM Cloud Schematics — workspace environment metadata
#
# This file is read by Schematics to pre-populate workspace variable
# definitions. The "value" fields are intentionally left blank for secrets;
# fill them in the Schematics UI or via the API after workspace creation.
#
# Reference:
#   https://cloud.ibm.com/docs/schematics?topic=schematics-workspaces

# ---------------------------------------------------------------------------
# Required Terraform environment variable consumed by the IBM provider.
# Schematics sets TF_VAR_* from workspace variables automatically; the
# provider also reads IBMCLOUD_REGION when region is not set in the block.
# ---------------------------------------------------------------------------
TF_VAR_ibmcloud_region=us-south
