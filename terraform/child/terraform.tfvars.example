##############################################################################
# child/ — example variable values (copy to terraform.tfvars and fill in)
##############################################################################

# IBM Cloud region for the provider — should match the child account region
ibmcloud_region = "us-south"

# CRN of the central COS archive bucket (from central/ workspace output: cos_bucket_crn)
# crn:v1:bluemix:public:cloud-object-storage:global:a/<central-account-id>:<instance-guid>:bucket:<bucket-name>
central_cos_bucket_crn = "REPLACE_WITH_COS_BUCKET_CRN"

# Private S3 endpoint of the central COS bucket (from central/ workspace output: cos_bucket_s3_endpoint_private)
# Use the public endpoint (cos_bucket_s3_endpoint_public) only if logs_service_endpoints = "public"
central_cos_bucket_endpoint = "REPLACE_WITH_COS_BUCKET_S3_ENDPOINT_PRIVATE"

# Primary metadata region for Logs Routing V3
logs_router_metadata_region = "us-south"

# Region for the Activity Tracker target resource
atracker_target_region = "us-south"

# Short prefix that identifies this child account in resource names
name_prefix = "prod-us-south"

##############################################################################
# Rarely changed
##############################################################################

# Days logs stay searchable in the local Logs instance before archiving to COS.
# Must be one of: 7, 14, 30, 60, 90.
# logs_retention_days = 30

# Plan for the local IBM Cloud Logs instance.
# logs_plan = "standard"

# Service endpoints for the local IBM Cloud Logs instance.
# Must match the endpoint type used for central_cos_bucket_endpoint.
# logs_service_endpoints = "private"

# Resource group for the local IBM Cloud Logs instance (leave empty for Default).
# logs_resource_group_id = ""
